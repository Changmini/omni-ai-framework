{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "allow": []
  },
  "enabledPlugins": {
    "omni-core@omni-ai-framework": true,
    "omni-guardrails@omni-ai-framework": true
  }
}
